        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT albums.id AS album_id, albums.title AS title, artists.name AS artist_name, COUNT(tracks.id) AS track_count, SUM(tracks.duration_ms) AS total_duration_ms FROM albums INNER JOIN artists ON artists.id = albums.artist_id LEFT JOIN tracks ON tracks.album_id = albums.id GROUP BY albums.id"
